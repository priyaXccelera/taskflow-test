data "aws_secretsmanager_secret" "worker_sms_provider_api_key" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/worker/SMS_PROVIDER_API_KEY"
}

resource "aws_cloudwatch_log_group" "worker" {
