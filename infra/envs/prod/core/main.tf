# Generated by PDLC Phase 4 (Infra & Pipeline agent) from the golden-path catalog. Review in the PR.
terraform {
  required_version = ">= 1.10.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0"
    }
  }
  backend "s3" {
    bucket       = "model-switch-e2e-1-phase1-to-3-tfstate"
    key          = "model-switch-e2e-1-phase1-to-3/prod/core/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = local.tags
  }
}

variable "project" {
  type    = string
  default = "model-switch-e2e-1-phase1-to-3"
}

variable "environment" {
  type    = string
  default = "prod"
}

variable "region" {
  type    = string
  default = "ap-south-1"
}

variable "owner" {
  type    = string
  default = "model-switch-e2e-1"
}

variable "vpc_cidr" {
  type    = string
  default = "10.30.0.0/16"
}

variable "kubernetes_version" {
  type    = string
  default = "1.33"
}

locals {
  tags = {
    project     = var.project
    environment = var.environment
    owner       = var.owner
    managed-by  = "opentofu-phase4"
  }
}

data "aws_availability_zones" "available" {
  state = "available"
}

module "network" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "6.7.3"

  name             = "${var.project}-${var.environment}"
  cidr             = var.vpc_cidr
  azs              = slice(data.aws_availability_zones.available.names, 0, 3)
  private_subnets  = [for i in range(3) : cidrsubnet(var.vpc_cidr, 4, i)]
  public_subnets   = [for i in range(3) : cidrsubnet(var.vpc_cidr, 8, 48 + i)]
  database_subnets = [for i in range(3) : cidrsubnet(var.vpc_cidr, 8, 56 + i)]

  create_database_subnet_group = true
  enable_nat_gateway           = true
  single_nat_gateway           = var.environment != "prod"
  enable_dns_hostnames         = true
}

output "vpc_id" {
  value = module.network.vpc_id
}

data "aws_caller_identity" "current" {}

variable "image_digests" {
  description = "Immutable image digest per image name (sha256:...). Promotion PRs change only images.auto.tfvars.json."
  type        = map(string)
}

locals {
  ecr_registry = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${var.region}.amazonaws.com"
}

module "ecs_cluster" {
  source  = "terraform-aws-modules/ecs/aws//modules/cluster"
  version = "7.6.3"

  name = "${var.project}-${var.environment}"

  setting = [{
    name  = "containerInsights"
    value = "enabled"
  }]

  default_capacity_provider_strategy = {
    FARGATE = {
      weight = 100
      base   = 1
    }
  }
}

output "ecs_cluster_name" {
  value = module.ecs_cluster.name
}

# CloudFront-scope resources must live in us-east-1: one provider alias and one shared web ACL for every static site.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
  default_tags {
    tags = local.tags
  }
}

resource "aws_wafv2_web_acl" "cdn" {
  provider = aws.us_east_1
  name     = "${var.project}-${var.environment}-cdn"
  scope    = "CLOUDFRONT"

  default_action {
    allow {}
  }

  rule {
    name     = "aws-common"
    priority = 1
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        vendor_name = "AWS"
        name        = "AWSManagedRulesCommonRuleSet"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "aws-common"
      sampled_requests_enabled   = true
    }
  }

  rule {
    name     = "aws-known-bad-inputs"
    priority = 2
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        vendor_name = "AWS"
        name        = "AWSManagedRulesKnownBadInputsRuleSet"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "aws-known-bad-inputs"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "${var.project}-${var.environment}-cdn"
    sampled_requests_enabled   = true
  }
}

resource "aws_cloudwatch_log_group" "cdn_waf" {
  provider          = aws.us_east_1
  name              = "aws-waf-logs-${var.project}-${var.environment}-cdn"
  retention_in_days = 365
}

resource "aws_wafv2_web_acl_logging_configuration" "cdn" {
  provider                = aws.us_east_1
  resource_arn            = aws_wafv2_web_acl.cdn.arn
  log_destination_configs = [aws_cloudwatch_log_group.cdn_waf.arn]
}

variable "certificate_arn" {
  description = "ACM certificate ARN for the public HTTPS listener (set per environment before apply)."
  type        = string
}

module "alb" {
  source  = "terraform-aws-modules/alb/aws"
  version = "10.5.1"

  name               = "${var.project}-${var.environment}"
  load_balancer_type = "application"
  vpc_id             = module.network.vpc_id
  subnets            = module.network.public_subnets

  enable_deletion_protection = var.environment == "prod"
  drop_invalid_header_fields = true

  security_group_ingress_rules = {
    https = {
      description = "HTTPS from the internet"
      from_port   = 443
      to_port     = 443
      ip_protocol = "tcp"
      cidr_ipv4   = "0.0.0.0/0"
    }
  }
  security_group_egress_rules = {
    vpc = {
      description = "To services in the VPC"
      ip_protocol = "-1"
      cidr_ipv4   = var.vpc_cidr
    }
  }

  listeners = {
    https = {
      port            = 443
      protocol        = "HTTPS"
      ssl_policy      = "ELBSecurityPolicy-TLS13-1-2-2021-06"
      certificate_arn = var.certificate_arn
      fixed_response = {
        content_type = "text/plain"
        message_body = "Not found"
        status_code  = "404"
      }
      rules = {
        membership_api = {
          priority = 10
          actions = [{
            forward = {
              target_group_key = "membership_api"
            }
          }]
          conditions = [{
            path_pattern = {
              values = ["/api/*"]
            }
          }]
        }
      }
    }
  }

  target_groups = {
    membership_api = {
      name_prefix       = "membe"
      protocol          = "HTTP"
      port              = 8080
      target_type       = "ip"
      create_attachment = false
      health_check = {
        enabled  = true
        path     = "/healthz"
        matcher  = "200"
        interval = 30
      }
    }
  }
}

# Rate limit and AWS managed rules in front of the public services (WAF on the load balancer).
resource "aws_wafv2_web_acl" "edge" {
  name  = "${var.project}-${var.environment}-edge"
  scope = "REGIONAL"

  default_action {
    allow {}
  }

  rule {
    name     = "rate-limit-per-ip"
    priority = 1
    action {
      block {}
    }
    statement {
      rate_based_statement {
        limit              = 1000
        aggregate_key_type = "IP"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "rate-limit-per-ip"
      sampled_requests_enabled   = true
    }
  }

  rule {
    name     = "aws-common"
    priority = 2
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        vendor_name = "AWS"
        name        = "AWSManagedRulesCommonRuleSet"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "aws-common"
      sampled_requests_enabled   = true
    }
  }

  rule {
    name     = "aws-known-bad-inputs"
    priority = 3
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        vendor_name = "AWS"
        name        = "AWSManagedRulesKnownBadInputsRuleSet"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "aws-known-bad-inputs"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "${var.project}-${var.environment}-edge"
    sampled_requests_enabled   = true
  }
}

resource "aws_cloudwatch_log_group" "edge_waf" {
  name              = "aws-waf-logs-${var.project}-${var.environment}-edge"
  retention_in_days = 365
}

resource "aws_wafv2_web_acl_logging_configuration" "edge" {
  resource_arn            = aws_wafv2_web_acl.edge.arn
  log_destination_configs = [aws_cloudwatch_log_group.edge_waf.arn]
}

resource "aws_wafv2_web_acl_association" "alb" {
  resource_arn = module.alb.arn
  web_acl_arn  = aws_wafv2_web_acl.edge.arn
}

output "alb_dns_name" {
  value = module.alb.dns_name
}

module "bucket_web_app" {
  source  = "terraform-aws-modules/s3-bucket/aws"
  version = "~> 5.0"

  bucket        = "${var.project}-${var.environment}-web-app"
  force_destroy = false

  versioning = {
    enabled = true
  }
  server_side_encryption_configuration = {
    rule = {
      apply_server_side_encryption_by_default = {
        sse_algorithm = "aws:kms"
      }
    }
  }
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Static site for web-app: private S3 bucket (bucket_web_app) served only through CloudFront (origin access control).
resource "aws_cloudfront_origin_access_control" "web_app" {
  name                              = "${var.project}-${var.environment}-web-app"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

resource "aws_cloudfront_distribution" "web_app" {
  enabled             = true
  comment             = "${var.project} ${var.environment} web-app"
  default_root_object = "index.html"
  price_class         = "PriceClass_200"
  web_acl_id          = aws_wafv2_web_acl.cdn.arn

  origin {
    origin_id                = "s3-web-app"
    domain_name              = module.bucket_web_app.s3_bucket_bucket_regional_domain_name
    origin_access_control_id = aws_cloudfront_origin_access_control.web_app.id
  }

  default_cache_behavior {
    target_origin_id       = "s3-web-app"
    viewer_protocol_policy = "redirect-to-https"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    compress               = true
    # AWS managed policies: CachingOptimized, SecurityHeadersPolicy.
    cache_policy_id            = "658327ea-f89d-4fab-a63d-7e88639e58f6"
    response_headers_policy_id = "67f7725c-6f97-4210-82d7-5512b31e9d03"
  }

  # Single-page app: unknown paths return index.html.
  custom_error_response {
    error_code         = 404
    response_code      = 200
    response_page_path = "/index.html"
  }
  custom_error_response {
    error_code         = 403
    response_code      = 200
    response_page_path = "/index.html"
  }

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    cloudfront_default_certificate = true
    minimum_protocol_version       = "TLSv1.2_2021"
  }
}

data "aws_iam_policy_document" "web_app_cdn_read" {
  statement {
    sid       = "CloudFrontRead"
    actions   = ["s3:GetObject"]
    resources = ["${module.bucket_web_app.s3_bucket_arn}/*"]
    principals {
      type        = "Service"
      identifiers = ["cloudfront.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "AWS:SourceArn"
      values   = [aws_cloudfront_distribution.web_app.arn]
    }
  }
}

resource "aws_s3_bucket_policy" "web_app_cdn_read" {
  bucket = module.bucket_web_app.s3_bucket_id
  policy = data.aws_iam_policy_document.web_app_cdn_read.json
}

output "web_app_cdn_domain" {
  value = aws_cloudfront_distribution.web_app.domain_name
}

resource "aws_security_group" "db_database" {
  name_prefix = "${var.project}-${var.environment}-database-db-"
  description = "Postgres access for database from private subnets only"
  vpc_id      = module.network.vpc_id

  ingress {
    description = "Postgres from private subnets"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = module.network.private_subnets_cidr_blocks
  }
}

module "db_database" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.0"

  identifier           = "${var.project}-${var.environment}-database"
  engine               = "postgres"
  engine_version       = "16"
  family               = "postgres16"
  major_engine_version = "16"
  instance_class       = "db.t4g.small"

  allocated_storage     = 20
  max_allocated_storage = 200
  storage_encrypted     = true

  db_name  = "database"
  username = "app"
  # Master password is created and rotated in AWS Secrets Manager; never written to code or outputs.
  manage_master_user_password = true

  db_subnet_group_name   = module.network.database_subnet_group_name
  vpc_security_group_ids = [aws_security_group.db_database.id]

  multi_az                = var.environment == "prod"
  deletion_protection     = true
  backup_retention_period = var.environment == "prod" ? 14 : 3
  skip_final_snapshot     = var.environment != "prod"
}


data "aws_secretsmanager_secret" "membership_api_database_url" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/membership-api/DATABASE_URL"
}

data "aws_secretsmanager_secret" "membership_api_payment_provider_api_key" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/membership-api/PAYMENT_PROVIDER_API_KEY"
}

data "aws_secretsmanager_secret" "membership_api_payment_webhook_hmac_secret" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/membership-api/PAYMENT_WEBHOOK_HMAC_SECRET"
}

data "aws_secretsmanager_secret" "membership_api_sms_provider_api_key" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/membership-api/SMS_PROVIDER_API_KEY"
}

data "aws_secretsmanager_secret" "membership_api_jwt_signing_secret" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/membership-api/JWT_SIGNING_SECRET"
}

resource "aws_cloudwatch_log_group" "membership_api" {
  name              = "/${var.project}/${var.environment}/membership-api"
  retention_in_days = 365
}

module "svc_membership_api" {
  source  = "terraform-aws-modules/ecs/aws//modules/service"
  version = "7.6.3"

  name        = "membership-api"
  cluster_arn = module.ecs_cluster.arn
  cpu         = 512
  memory      = 1024

  desired_count            = 2
  enable_autoscaling       = true
  autoscaling_min_capacity = 2
  autoscaling_max_capacity = 4

  enable_execute_command = false
  subnet_ids             = module.network.private_subnets
  assign_public_ip       = false
  task_exec_secret_arns = [
    data.aws_secretsmanager_secret.membership_api_database_url.arn,
    data.aws_secretsmanager_secret.membership_api_payment_provider_api_key.arn,
    data.aws_secretsmanager_secret.membership_api_payment_webhook_hmac_secret.arn,
    data.aws_secretsmanager_secret.membership_api_sms_provider_api_key.arn,
    data.aws_secretsmanager_secret.membership_api_jwt_signing_secret.arn,
  ]

  container_definitions = {
    membership_api = {
      image                  = "${local.ecr_registry}/${var.project}/membership-api@${var.image_digests["membership-api"]}"
      essential              = true
      readonlyRootFilesystem = true
      portMappings = [{
        name          = "http"
        containerPort = 8080
        protocol      = "tcp"
      }]
      environment = [{
        name  = "APP_ENV"
        value = var.environment
      }]
      secrets = [
        {
          name      = "DATABASE_URL"
          valueFrom = data.aws_secretsmanager_secret.membership_api_database_url.arn
        },
        {
          name      = "PAYMENT_PROVIDER_API_KEY"
          valueFrom = data.aws_secretsmanager_secret.membership_api_payment_provider_api_key.arn
        },
        {
          name      = "PAYMENT_WEBHOOK_HMAC_SECRET"
          valueFrom = data.aws_secretsmanager_secret.membership_api_payment_webhook_hmac_secret.arn
        },
        {
          name      = "SMS_PROVIDER_API_KEY"
          valueFrom = data.aws_secretsmanager_secret.membership_api_sms_provider_api_key.arn
        },
        {
          name      = "JWT_SIGNING_SECRET"
          valueFrom = data.aws_secretsmanager_secret.membership_api_jwt_signing_secret.arn
        },
      ]
      enable_cloudwatch_logging   = true
      create_cloudwatch_log_group = false
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.membership_api.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "membership-api"
        }
      }
    }
  }

  load_balancer = {
    service = {
      target_group_arn = module.alb.target_groups["membership_api"].arn
      container_name   = "membership_api"
      container_port   = 8080
    }
  }

  security_group_ingress_rules = {
    alb = {
      description                  = "HTTP from the load balancer"
      from_port                    = 8080
      to_port                      = 8080
      ip_protocol                  = "tcp"
      referenced_security_group_id = module.alb.security_group_id
    }
  }
  security_group_egress_rules = {
    all = {
      description = "Outbound to AWS APIs, the database and external providers"
      ip_protocol = "-1"
      cidr_ipv4   = "0.0.0.0/0"
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "membership_api_cpu" {
  alarm_name          = "${var.project}-${var.environment}-membership-api-cpu-high"
  namespace           = "AWS/ECS"
  metric_name         = "CPUUtilization"
  statistic           = "Average"
  period              = 300
  evaluation_periods  = 2
  threshold           = 85
  comparison_operator = "GreaterThanThreshold"
  dimensions = {
    ClusterName = module.ecs_cluster.name
    ServiceName = module.svc_membership_api.name
  }
}

resource "aws_cloudwatch_metric_alarm" "membership_api_5xx" {
  alarm_name          = "${var.project}-${var.environment}-membership-api-5xx-rate"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 2
  threshold           = 1.0
  treat_missing_data  = "notBreaching"

  metric_query {
    id          = "rate"
    expression  = "100 * errors / MAX([requests, 1])"
    label       = "5xx percent"
    return_data = true
  }
  metric_query {
    id = "errors"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_Target_5XX_Count"
      period      = 300
      stat        = "Sum"
      dimensions = {
        LoadBalancer = module.alb.arn_suffix
        TargetGroup  = module.alb.target_groups["membership_api"].arn_suffix
      }
    }
  }
  metric_query {
    id = "requests"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "RequestCount"
      period      = 300
      stat        = "Sum"
      dimensions = {
        LoadBalancer = module.alb.arn_suffix
        TargetGroup  = module.alb.target_groups["membership_api"].arn_suffix
      }
    }
  }
}

resource "aws_cloudwatch_metric_alarm" "membership_api_p95" {
  alarm_name          = "${var.project}-${var.environment}-membership-api-p95-latency"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "TargetResponseTime"
  extended_statistic  = "p95"
  period              = 300
  evaluation_periods  = 2
  threshold           = 0.5
  comparison_operator = "GreaterThanThreshold"
  treat_missing_data  = "notBreaching"
  dimensions = {
    LoadBalancer = module.alb.arn_suffix
    TargetGroup  = module.alb.target_groups["membership_api"].arn_suffix
  }
}


data "aws_secretsmanager_secret" "worker_database_url" {
  name = "/model-switch-e2e-1-phase1-to-3/prod/worker/DATABASE_URL"
}

data "aws_secretsmanager_secret" "worker_payment_provider_api_key" {
