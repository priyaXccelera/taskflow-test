}

resource "aws_cloudwatch_metric_alarm" "worker_cpu" {
  alarm_name          = "${var.project}-${var.environment}-worker-cpu-high"
  namespace           = "AWS/ECS"
  metric_name         = "CPUUtilization"
  statistic           = "Average"
  period              = 300
  evaluation_periods  = 2
  threshold           = 85
  comparison_operator = "GreaterThanThreshold"
  dimensions = {
    ClusterName = module.ecs_cluster.name
    ServiceName = module.svc_worker.name
  }
}
