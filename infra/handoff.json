  "images": {
    "membership-api": {
      "repository": "ECR_REGISTRY/model-switch-e2e-1-phase1-to-3/membership-api",
      "source_repo": "priyaXccelera/taskflow-test",
      "ci_workflow": ".github/workflows/ci-membership-api.yml",
      "ci_artifact": "image-membership-api",
      "tag": "<branch>-<commit sha>",
      "workloads": [
        "membership-api",
        "worker"
      ]
    }
  },
  "workloads": {
    "membership-api": {
      "component_id": "ctr-membership-api",
      "kind": "service",
      "image": "membership-api",
      "shares_image": false,
      "http": true,
      "public": true,
      "port": 8080,
      "health_path": "/healthz",
      "data_classification": "confidential",
      "replicas": {
        "dev": {
          "min": 1,
          "max": 2
        },
        "qa": {
          "min": 1,
          "max": 2
        },
        "stg": {
          "min": 1,
          "max": 2
        },
        "prod": {
          "min": 2,
          "max": 4
        }
      }
    },
    "worker": {
      "component_id": "ctr-worker",
      "kind": "worker",
      "image": "membership-api",
      "shares_image": true,
      "http": false,
      "public": false,
      "port": 8080,
      "health_path": "/healthz",
      "data_classification": "confidential",
      "replicas": {
        "dev": {
          "min": 1,
          "max": 2
        },
        "qa": {
          "min": 1,
          "max": 2
        },
        "stg": {
          "min": 1,
          "max": 2
        },
        "prod": {
          "min": 2,
          "max": 4
        }
      }
    }
  },
  "slos": {},
  "scope": "Infrastructure and CI only. Deploying images (manifests, promotion, approvals, rollback) is owned by the deployment side."
}
